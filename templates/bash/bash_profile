# OpenCode Sandbox - User Bash Profile
# This file is copied to ~/.bash_profile during project initialization and runs
# on container start. It handles automatic opencode startup when requested.

if [[ "${START_WEB}" == "true" ]]; then
  echo "Starting OpenCode Web (serve) on port 4096... Ctrl+C stops and removes the container."
  exec opencode serve --hostname 0.0.0.0 --port 4096
elif [[ "${START_OPENCODE}" == "true" ]]; then
  echo "Starting OpenCode..."
  opencode
fi