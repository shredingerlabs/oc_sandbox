{
  "name": "opencode-sandbox",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "remoteUser": "dev",

  "workspaceMount": "source=${localWorkspaceFolder}/project,target=/home/dev/project,type=bind,consistency=cached",
  "workspaceFolder": "/home/dev/project",

  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt", "no-new-privileges",
    "--userns=keep-id",
    "--group-add", "keep-groups"
  ],

  "containerEnv": {
    "HTTPS_PROXY": "http://host.containers.internal:3128",
    "HTTP_PROXY": "http://host.containers.internal:3128",
    "NO_PROXY": "localhost,127.0.0.1",
    "XDG_CONFIG_HOME": "/home/dev/.config",
    "XDG_DATA_HOME": "/home/dev/.local/share",
    "GIT_CONFIG_GLOBAL": "/home/dev/.git_local/gitconfig",
    "GLAB_CONFIG_DIR": "/home/dev/.git_local/glab-cli",
    "PLAYWRIGHT_BROWSERS_PATH": "/usr/local/share/playwright-browsers"
  },

  "mounts": [
    "source=${localWorkspaceFolder}/.opencode_config,target=/home/dev/.config/opencode,type=bind",
    "source=${localWorkspaceFolder}/.opencode_data,target=/home/dev/.local/share/opencode,type=bind",
    "source=${localWorkspaceFolder}/.ssh_local,target=/home/dev/.ssh,type=bind,readonly=true",
    "source=${localWorkspaceFolder}/.git_local,target=/home/dev/.git_local,type=bind,readonly=true"
  ],
  "//": "USB device passthrough (e.g. Picoscope) requires start.sh --hil_mode. The devcontainer JSON format cannot resolve udev symlinks dynamically, so use start.sh for HIL mode.",

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "ms-python.python",
        "dbaeumer.vscode-eslint",
        "ms-vscode.cpptools"
      ]
    }
  }
}
