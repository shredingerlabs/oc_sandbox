# udev-Regeln für USB-Oszilloskop (PicoScope) + serielle HIL-Geräte (MCU).
#
# Ziel: alle relevanten Geräte bekommen zusätzlich zu ihrem normalen Pfad
# einen stabilen Symlink unterhalb von /dev/hil/. Dieser Ordner wird
# (statt einzelner --device-Snapshots) LIVE in den Container gemountet,
# damit eine Neu-Enumeration (neue Bus/Device-Nummer bzw. neue tty-Nummer)
# den Containerzugriff nicht mehr zerstört.
#
# Installation:
#   sudo cp 99-hil.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#
# Prüfen:
#   ls -l /dev/scope /dev/hil/

# --- PicoScope 2000 series ------------------------------------------------
# Bus 007 Device 028: ID 0ce9:1007 Pico Technology PicoScope 2000 series PC Oszilloscope
SUBSYSTEM=="usb", ATTR{idVendor}=="0ce9", ATTR{idProduct}=="1007", \
    SYMLINK+="scope0 hil/scope0", MODE="0660", GROUP="dialout", TAG+="uaccess"

# USB-Autosuspend für das PicoScope abschalten. Autosuspend/Power-Management
# ist eine häufige Ursache für sporadisches Disconnect/Reconnect (= neue
# Bus/Device-Nummer), auch ohne dass das Gerät wirklich abgezogen wurde.
SUBSYSTEM=="usb", ATTR{idVendor}=="0ce9", ATTR{idProduct}=="1007", \
    TEST=="power/control", ATTR{power/control}="on"

# Falls mehrere scopes/Geräte-Typen im Einsatz sind, weitere Zeilen mit
# eigenem SYMLINK (scope1, hil/scope1, ...) ergänzen.

# --- Serielle HIL-Geräte (Arduino/ESP32 etc. über USB) --------------------
# Stabiler Zugriffspunkt unter /dev/hil/, unabhängig davon ob der Kernel
# das Gerät gerade als ttyUSB0, ttyUSB1, ttyACM0, ... nummeriert.
SUBSYSTEM=="tty", KERNEL=="ttyUSB[0-9]*", MODE="0660", GROUP="dialout", \
    SYMLINK+="hil/%k", TAG+="uaccess"

SUBSYSTEM=="tty", KERNEL=="ttyACM[0-9]*", MODE="0660", GROUP="dialout", \
    SYMLINK+="hil/%k", TAG+="uaccess"

# Optional, aber empfohlen: Autosuspend für ALLE USB-Geräte global abschalten.
# Das ist die häufigste Ursache für sporadische USB-Disconnects bei
# Mikrocontroller-Boards während Flash/Debug-Sessions. Falls das zu breit
# gefasst ist, die Zeile entfernen und stattdessen pro Vendor/Product wie
# oben beim PicoScope einschränken.
ACTION=="add", SUBSYSTEM=="usb", TEST=="power/control", ATTR{power/control}="on"

# ttyAMA (onboard UART, z.B. Raspberry-Pi-GPIO-UART) ist kein USB-Gerät und
# re-enumeriert nicht - dafür ist kein Symlink/Autosuspend-Fix nötig.
